# Load required libraries
library(ggplot2)
library(viridisLite)
library(dplyr)
library(tidyr)
library(ggridges)
library(patchwork)
library(stringr)  # Added for string manipulation

# Publication-quality theme with larger fonts and no titles
publication_theme <- theme_minimal() +
  theme(
    # Larger base font sizes for readability at print scale
    text = element_text(size = 14, family = "Arial"),
    axis.text = element_text(size = 12, color = "black"),
    axis.title = element_text(size = 14, face = "bold", color = "black"),
    legend.title = element_text(size = 13, face = "bold", color = "black"),
    legend.text = element_text(size = 12, color = "black"),
    
    # Clean panel appearance
    panel.grid.minor = element_blank(),
    panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
    panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8),
    panel.background = element_rect(fill = "white"),
    
    # Remove titles for publication
    plot.title = element_blank(),
    plot.subtitle = element_blank(),
    
    # Clean legend with improved padding
    legend.position = "right",
    legend.background = element_rect(fill = "white", color = "black", linewidth = 0.5),
    legend.key = element_rect(fill = "white"),
    legend.margin = margin(t = 10, r = 10, b = 10, l = 15),  # More padding around legend
    legend.box.margin = margin(t = 5, r = 5, b = 5, l = 5),  # Margin around legend box
    legend.key.width = unit(1.2, "cm"),   # Wider legend keys
    legend.key.height = unit(0.6, "cm"),  # Taller legend keys
    
    # Margins for proper spacing
    plot.margin = margin(10, 10, 10, 10, "pt"),
    
    # Axis appearance
    axis.line = element_line(color = "black", linewidth = 0.8),
    axis.ticks = element_line(color = "black", linewidth = 0.5),
    axis.ticks.length = unit(0.2, "cm")
  )

# Create a mapping from abbreviated to full region names
region_names <- c(
  "Pen" = "Acadian Peninsula",
  "Res" = "Restigouche",
  "Mad" = "Madawaska"
)

# Add full region names to your data, clean gene names, and remove NA genes
Results_full <- Results_cleaned %>%
  mutate(region_full = region_names[region]) %>%
  # Clean gene names by removing NM identifiers and extract just the gene symbol
  mutate(Gene_clean = case_when(
    is.na(Gene) | Gene == "NA" ~ NA_character_,
    grepl("\\(NM_", Gene) ~ str_extract(Gene, "^[^(]+"),  # Extract part before (NM_
    TRUE ~ Gene
  )) %>%
  filter(!is.na(Gene_clean) & Gene_clean != "NA" & Gene_clean != "")  # Remove NA values and empty strings

# 1. Horizontal Stacked Bar Chart - Panel A
top_genes <- Results_full %>%
  count(Gene_clean) %>%
  arrange(desc(n)) %>%
  head(12) %>%  # Reduced for better readability
  pull(Gene_clean)

top_gene_data <- Results_full %>%
  filter(Gene_clean %in% top_genes) %>%
  group_by(Gene_clean, region_full) %>%
  summarize(count = n(), .groups = "drop") %>%
  group_by(Gene_clean) %>%
  mutate(total = sum(count),
         percentage = count / total * 100) %>%
  arrange(desc(total), Gene_clean)

# Panel A - Horizontal stacked bar chart with improved legend
p1 <- ggplot(top_gene_data, aes(x = count, y = reorder(Gene_clean, total), fill = region_full)) +
  geom_bar(stat = "identity", position = "stack", width = 0.7) +
  scale_fill_viridis_d(option = "viridis", begin = 0.2, end = 0.8, name = "Region") +
  scale_x_continuous(expand = c(0, 0), breaks = scales::pretty_breaks(n = 5)) +
  labs(
    x = "Variant allele count",
    y = "Gene"
  ) +
  publication_theme +
  theme(
    legend.position = "right",
    legend.margin = margin(t = 15, r = 15, b = 15, l = 20),  # Generous padding around legend
    legend.box.margin = margin(t = 10, r = 10, b = 10, l = 10),  # Box margin
    legend.key.width = unit(1.5, "cm"),   # Wider legend keys for better spacing
    legend.key.height = unit(0.8, "cm"),  # Taller legend keys
    legend.spacing.y = unit(0.3, "cm"),   # Vertical spacing between legend items
    plot.margin = margin(25, 25, 10, 10, "pt")  # More right margin for legend space
  ) +
  guides(fill = guide_legend(
    title.position = "top",     # Position title above legend items
    title.hjust = 0.5,          # Center the title
    label.position = "right",   # Position labels to the right
    byrow = TRUE,               # Arrange in rows
    override.aes = list(size = 1.2)  # Slightly larger legend symbols
  ))

# 2. Ridge Plot - Panel B
region_profiles <- Results_full %>%
  group_by(region_full, Gene_clean) %>%
  summarize(count = n(), .groups = "drop") %>%
  group_by(region_full) %>%
  mutate(proportion = count / sum(count)) %>%
  ungroup()

p2 <- ggplot(region_profiles, aes(x = proportion, y = region_full, fill = region_full)) +
  geom_density_ridges(scale = 1.5, alpha = 0.8, bandwidth = 0.003) +
  scale_fill_viridis_d(option = "viridis", begin = 0.2, end = 0.8) +
  scale_x_continuous(expand = c(0.01, 0), limits = c(0, 0.15), 
                     breaks = seq(0, 0.15, 0.03)) +
  labs(
    x = "Proportion of total regional expression",
    y = "Region"
  ) +
  theme_minimal() +
  theme(
    text = element_text(size = 14, family = "Arial"),
    axis.text = element_text(size = 12, color = "black"),
    axis.title = element_text(size = 14, face = "bold", color = "black"),
    legend.position = "none",
    panel.grid.minor = element_blank(),
    panel.grid.major.x = element_line(color = "gray90", linewidth = 0.3),
    panel.grid.major.y = element_blank(),
    axis.line = element_line(color = "black", linewidth = 0.8),
    axis.ticks = element_line(color = "black", linewidth = 0.5),
    plot.margin = margin(25, 10, 10, 10, "pt")  # Increase top margin for panel label
  )

# 3. Bubble Plot - Panel C
gene_variation <- Results_full %>%
  group_by(Gene_clean, region_full) %>%
  summarize(count = n(), .groups = "drop") %>%
  pivot_wider(names_from = region_full, values_from = count, values_fill = 0) %>%
  rowwise() %>%
  mutate(
    total = sum(c_across(where(is.numeric))),
    variation = sd(c_across(where(is.numeric))) / (mean(c_across(where(is.numeric))) + 0.1)
  ) %>%
  ungroup() %>%
  arrange(desc(variation)) %>%
  head(12)  # Reduced for clarity

region_columns <- c("Acadian Peninsula", "Madawaska", "Restigouche")

bubble_data <- gene_variation %>%
  pivot_longer(
    cols = all_of(region_columns), 
    names_to = "region_full",
    values_to = "count"
  ) %>%
  mutate(proportion = count / total)

p3 <- ggplot(bubble_data, aes(x = region_full, y = reorder(Gene_clean, -variation), 
                              size = count, color = proportion)) +
  geom_point(alpha = 0.85, stroke = 0.5) +
  scale_size_continuous(range = c(2, 10), breaks = c(1, 5, 10, 15), 
                        name = "Count", guide = guide_legend(override.aes = list(alpha = 1))) +
  scale_color_viridis_c(option = "viridis", direction = -1, name = "Proportion",
                        guide = guide_colorbar(barwidth = 1.2, barheight = 8)) +
  scale_x_discrete(expand = c(0.1, 0.1)) +
  labs(
    x = "Region",
    y = "Gene"
  ) +
  publication_theme +
  theme(
    panel.grid.major = element_line(color = "gray95", linewidth = 0.3),
    axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1),
    legend.box = "horizontal",
    legend.position = "bottom",
    legend.margin = margin(t = 20, r = 10, b = 15, l = 10),  # More top margin for legend
    legend.box.margin = margin(t = 10, r = 10, b = 10, l = 10),  # Box margin
    legend.box.spacing = unit(1, "cm"),     # More space between legend elements
    legend.key.width = unit(1.5, "cm"),     # Wider legend keys
    legend.key.height = unit(0.8, "cm"),    # Taller legend keys
    legend.spacing.x = unit(0.8, "cm"),     # Horizontal spacing between legends
    plot.margin = margin(25, 10, 20, 10, "pt")  # More bottom margin for legend
  ) +
  guides(
    size = guide_legend(
      title.position = "top",
      title.hjust = 0.5,
      label.position = "bottom",
      override.aes = list(alpha = 1),
      keywidth = unit(1.2, "cm"),
      keyheight = unit(0.8, "cm")
    ),
    color = guide_colorbar(
      title.position = "top",
      title.hjust = 0.5,
      barwidth = unit(3, "cm"),    # Wider color bar
      barheight = unit(0.8, "cm"), # Consistent height
      label.position = "bottom"
    )
  )

# Updated panel label function to position label above the plot
add_panel_label <- function(plot, label) {
  plot + 
    annotation_custom(
      grob = grid::textGrob(label, x = 0.02, y = 1.05,  # Position above plot (y > 1)
                            gp = grid::gpar(fontsize = 16, fontface = "bold")),
      xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf
    ) +
    coord_cartesian(clip = "off")  # Allow drawing outside plot area
}

