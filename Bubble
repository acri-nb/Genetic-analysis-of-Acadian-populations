# Memory-optimized but visually appealing network visualization
library(igraph)
library(ggplot2)
library(viridisLite)

# First try to increase R's memory limit if possible
# Uncomment this if needed:
# memory.limit(size = 32000)  # For Windows
# For Linux/Mac, you might need to restart R with more memory

# Create region correlation matrix (simplified method)
region_gene_matrix <- Results_cleaned %>%
  group_by(region, Gene) %>%
  summarize(count = n(), .groups = "drop") %>%
  pivot_wider(names_from = Gene, values_from = count, values_fill = 0)

# Convert to proper matrix with rownames
region_matrix <- as.matrix(region_gene_matrix[, -1])
rownames(region_matrix) <- region_gene_matrix$region

# Calculate correlation matrix
region_correlation <- cor(t(region_matrix))

# Create a minimal network object
g <- graph_from_adjacency_matrix(
  region_correlation,
  mode = "undirected",
  weighted = TRUE,
  diag = FALSE
)

# Pre-compute layout to reduce computational load
set.seed(42)  # For reproducibility
layout <- layout_with_fr(g)

# Create edge dataframe manually instead of using ggraph
edges <- as.data.frame(get.edgelist(g))
names(edges) <- c("from", "to")
edges$weight <- E(g)$weight
edges$width <- edges$weight * 3
edges$alpha <- edges$weight * 0.7 + 0.3

# Create node dataframe
nodes <- data.frame(
  name = V(g)$name,
  id = 1:length(V(g)),
  x = layout[,1],
  y = layout[,2]
)

# Generate viridis colors
node_colors <- viridis(nrow(nodes), option = "E", begin = 0.2, end = 0.9)
edge_color <- viridis(1, option = "E", begin = 0.5)

# Create a ggplot visualization with manual network elements
# This is more memory efficient than using ggraph's geom_edge_link
p4 <- ggplot() +
  # Add edges as segments
  geom_segment(
    data = edges,
    aes(
      x = nodes$x[match(from, nodes$name)],
      y = nodes$y[match(from, nodes$name)],
      xend = nodes$x[match(to, nodes$name)],
      yend = nodes$y[match(to, nodes$name)],
      size = width,
      alpha = alpha
    ),
    color = edge_color,
    lineend = "round"
  ) +
  # Add nodes as points
  geom_point(
    data = nodes,
    aes(x = x, y = y),
    size = 30,
    color = node_colors
  ) +
  # Add node labels
  geom_text(
    data = nodes,
    aes(x = x, y = y, label = name),
    color = "white",
    size = 5
  ) +
  # Format scales
  scale_size_continuous(range = c(1, 3), guide = "none") +
  scale_alpha_continuous(range = c(0.3, 1), guide = "none") +
  # Add titles
  labs(
    title = "Similarity Network of Regional Gene Expression Profiles",
    subtitle = "Edge weight indicates correlation in gene expression patterns"
  ) +
  # Use a clean theme
  theme_void() +
  theme(
    plot.title = element_text(size = 14, face = "bold", hjust = 0.5),
    plot.subtitle = element_text(size = 11, hjust = 0.5),
    legend.position = "none"
  )

# Add edge labels with correlation values if desired
edge_labels <- data.frame(
  from = edges$from,
  to = edges$to,
  x = (nodes$x[match(edges$from, nodes$name)] + nodes$x[match(edges$to, nodes$name)]) / 2,
  y = (nodes$y[match(edges$from, nodes$name)] + nodes$y[match(edges$to, nodes$name)]) / 2,
  label = round(edges$weight, 2)
)

p4 <- p4 +
  geom_text(
    data = edge_labels,
    aes(x = x, y = y, label = label),
    color = "black",
    size = 3.5,
    bg.color = "white",
    bg.r = 0.15
  )

# Save with lower DPI to reduce memory usage while maintaining quality
ggsave(
  "~/Desktop/region_similarity_network.pdf",
  p4,
  width = 8,
  height = 7,
  dpi = 200,  # Lower DPI to save memory
  limitsize = FALSE
)

# Alternative method: Try direct PDF device which sometimes uses less memory
pdf("~/Desktop/region_similarity_network_alt.pdf", width = 8, height = 7)
print(p4)
dev.off()




