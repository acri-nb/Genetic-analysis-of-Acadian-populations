# Updated panel label function to position label above the plot
add_panel_label <- function(plot, label) {
  plot + 
    annotation_custom(
      grob = grid::textGrob(label, x = 0.02, y = 1.05,  # Position above plot (y > 1)
                            gp = grid::gpar(fontsize = 16, fontface = "bold")),
      xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf
    ) +
    coord_cartesian(clip = "off")  # Allow drawing outside plot area
}

