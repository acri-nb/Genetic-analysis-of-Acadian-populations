    ci_upper_acadian = sapply(1:nrow(df), function(i) 
      calculate_jeffreys_ci(df$Frequency_Acadian[i], 360)[2]),
    
    # For gnomAD data
    ci_lower_gnomad = sapply(1:nrow(df), function(i) 
