# ============================================================================
# CALCULATE PIE CHART RADIUS FOR ANNOTATION LINE POSITIONING
# ============================================================================

# Calculate pie chart radius in map coordinates
pie_scale_value <- 10
pie_radius <- 0.67  # Adjust this value based on visual inspection

# Calculate annotation line endpoints
annotation_data <- data.frame(
  region = c("Res", "Pen", "Mad", "Mem"),
  x_center = c(-66.5, -64.9, -68.3, -64.5),
  y_center = c(48.0, 47.7, 47.4, 46.0),
  x_label = c(-66.5 + 0.8, -64.9 + 0.8, -68.3 - 0.8, -64.5 + 0.8),
  y_label = c(48.0 + 0.5, 47.7 + 0.5, 47.4 + 0.5, 46.0 + 0.5)
)

# Calculate angle from center to label for each point
annotation_data <- annotation_data %>%
  mutate(
    # Calculate angle
    angle = atan2(y_label - y_center, x_label - x_center),
    # Calculate edge point on circle
    x_edge = x_center + pie_radius * cos(angle),
    y_edge = y_center + pie_radius * sin(angle)
  )

