# Perform chi-square test for each top gene
chi_square_results <- data.frame()
for (gene in top_genes) {
  gene_data <- Results_full %>%
    filter(Gene_clean == gene) %>%
    count(region_full) %>%
    complete(region_full = region_names, fill = list(n = 0))
  
  # Create contingency table
  observed <- gene_data$n
  total <- sum(observed)
  expected <- rep(total/3, 3)  # Equal distribution expected
  
  # Chi-square test
  test <- chisq.test(observed)
  
  chi_square_results <- rbind(chi_square_results, data.frame(
    Gene = gene,
    chi_square = test$statistic,
    p_value = test$p.value,
    significant = ifelse(test$p.value < 0.05, "Yes", "No")
  ))
}

