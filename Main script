significant_fdr <- df %>% filter(fdr_corrected_p < 0.05)

# Function to calculate Jeffreys confidence interval for binomial proportion
calculate_jeffreys_ci <- function(x, n, alpha = 0.05) {
  lower <- qbeta(alpha/2, x + 0.5, n - x + 0.5)
  upper <- qbeta(1 - alpha/2, x + 0.5, n - x + 0.5)
  return(c(lower = lower, upper = upper))
}

