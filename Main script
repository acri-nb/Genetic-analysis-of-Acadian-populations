    sd_variants = sd(n_variants),
    min_variants = min(n_variants),
    max_variants = max(n_variants),
    # 95% CI
    ci_lower = mean(n_variants) - qt(0.975, n() - 1) * sd(n_variants) / sqrt(n()),
    ci_upper = mean(n_variants) + qt(0.975, n() - 1) * sd(n_variants) / sqrt(n()),
    # Percentiles
    p25 = quantile(n_variants, 0.25),
    p75 = quantile(n_variants, 0.75),
